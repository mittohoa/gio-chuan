{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giờ Chuẩn",
  "mainBinaryName": "mittohoa-timeis",
  "version": "0.1.0",
  "identifier": "com.mittohoa.timeis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Giờ Chuẩn",
        "width": 900,
        "height": 700,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://cloudflare.com https://timeapi.io; form-action 'none'; base-uri 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Dong ho chinh xac",
    "longDescription": "Dong ho dong bo theo NTP, xem gio moi mui gio, chay duoc ca khi ngoai tuyen.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
